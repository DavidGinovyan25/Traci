Enum Role {
  admin
  user
}

Enum MovieGenre {
  ACTION
  ADVENTURE
  ANIMATION
  COMEDY
  CRIME
  DOCUMENTARY
  DRAMA
  FAMILY
  FANTASY
  HISTORY
  HORROR
  MUSIC
  MYSTERY
  ROMANCE
  SCIENCE_FICTION
  THRILLER
  WAR
  WESTERN
}

Enum MovieStatus {
  PLANNED
  WATCHING
  WATCHED
  DROPPED
}

Table User {
  id uuid [pk]
  role Role [not null, default: "user"]
  username varchar(50) [not null, unique]
  first_name text [not null]
  second_name text [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  is_blocked bool [not null, default: false]
}

Table Movie {
  id uuid [pk]
  name text [not null]
  duration_min int [not null]
  genre MovieGenre [not null]
  release_year int [not null]
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]  
}

Table UserMovie {
  id uuid [pk]
  movie_id uuid [not null]
  user_id uuid [not null]
  personal_rating int [note: "1-10"]
  review varchar(1000)
  status MovieStatus [not null, default: "PLANNED"]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, movie_id) [unique]
  }
}

Ref: UserMovie.movie_id > Movie.id
Ref: UserMovie.user_id > User.id

