@startuml
title Traci — CJM администратора

start

:Открыть Traci;
:Открыть страницу авторизации;
:Ввести email и пароль;

while (Авторизация успешна?) is (Нет)
    :Показать ошибку авторизации;
    :Исправить email или пароль;
endwhile (Да)

if (Роль ADMIN?) then (Нет)
    :Открыть интерфейс пользователя;
    stop
else (Да)
    :Открыть Admin Panel;
endif

while (Продолжить работу?) is (Да)

    if (Что сделать?) then (Управлять фильмами)

        :Открыть список фильмов;

        if (Действие?) then (Добавить)
            :Открыть форму создания фильма;
            :Ввести данные фильма;
            :Создать фильм;

        elseif (Изменить) then
            :Выбрать фильм;
            :Открыть форму редактирования;
            :Изменить данные фильма;
            :Сохранить изменения;

        else (Удалить)
            :Выбрать фильм;
            :Подтвердить удаление;
            :Удалить фильм;
        endif

    else (Управлять пользователями)

        :Открыть список пользователей;
        :Выбрать пользователя;

        if (Пользователь заблокирован?) then (Да)
            :Разблокировать пользователя;
        else (Нет)
            :Заблокировать пользователя;
        endif

    endif

    :Вернуться в Admin Panel;

endwhile (Нет)

:Выйти из аккаунта;

stop

@enduml