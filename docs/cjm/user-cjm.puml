@startuml
title Traci — CJM пользователя

start

:Открыть Traci;

if (Есть аккаунт?) then (Нет)
    :Открыть страницу регистрации;
    :Ввести username, имя, фамилию, email и пароль;
    :Зарегистрироваться;
endif

:Открыть страницу авторизации;
:Ввести email и пароль;

while (Авторизация успешна?) is (Нет)
    :Показать ошибку авторизации;
    :Исправить email или пароль;
endwhile (Да)

:Открыть каталог фильмов;

while (Продолжить пользоваться Traci?) is (Да)

    if (Что сделать?) then (Работать с каталогом)

        :Открыть каталог фильмов;

        if (Искать фильм?) then (Да)
            :Ввести поисковый запрос;
            :Просмотреть результаты поиска;
        endif

        :Выбрать фильм;
        :Открыть страницу фильма;
        :Просмотреть информацию о фильме;

        if (Добавить в коллекцию?) then (Да)
            :Добавить фильм в My Movies;
            :Выбрать статус;
        endif

    else (Работать с коллекцией)

        :Открыть My Movies;

        if (Фильтровать коллекцию?) then (Да)
            :Выбрать статус;
            :Просмотреть отфильтрованные фильмы;
        endif

        :Выбрать фильм из коллекции;

        if (Изменить запись?) then (Да)
            :Изменить статус;
            :Поставить или изменить оценку;
            :Сохранить изменения;
        endif

        if (Удалить из коллекции?) then (Да)
            :Подтвердить удаление;
            :Удалить фильм из My Movies;
        endif

    endif

endwhile (Нет)

:Выйти из аккаунта;

stop

@enduml